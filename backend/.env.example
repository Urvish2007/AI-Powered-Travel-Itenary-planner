# ---- Application ----
ENVIRONMENT=local
DEBUG=true
APP_NAME="AI Itinerary Planner API"
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3111,http://127.0.0.1:3111

# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=itinerary_planner
# Set true only on MongoDB Atlas (or a deployment with Atlas Search).
# When false, semantic search falls back to in-process cosine similarity.
MONGODB_VECTOR_SEARCH_ENABLED=false
MONGODB_VECTOR_INDEX_NAME=place_embedding_index

# ---- Redis (optional) ----
REDIS_ENABLED=false
REDIS_URI=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ---- Celery (optional) ----
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (and validated) in staging and production.
SECRET_KEY=dev-only-insecure-secret-key-change-me-in-every-real-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- AI ----
# stub | gemini | groq   (anthropic and openai are also supported)
# "stub" is deterministic and needs no API key; the full pipeline still runs.
LLM_PROVIDER=stub
# Set ONE of these keys to match LLM_PROVIDER:
#   LLM_PROVIDER=gemini  ->  GOOGLE_GEMINI_KEY   (https://aistudio.google.com/apikey)
#   LLM_PROVIDER=groq    ->  GROQ_API_KEY        (https://console.groq.com/keys)
# GOOGLE_GEMINI_KEY=
# GROQ_API_KEY=
#
# Leave the model names unset to use the provider default:
#   gemini -> gemini-3.8-flash   (fast: gemini-3.5-flash-lite)
#   groq   -> openai/gpt-oss-120b (fast: openai/gpt-oss-20b)
# Providers retire models on a schedule (Gemini 2.5 shuts down 16 Oct 2026;
# Groq's Llama 3.x models are already retired), so check their model pages
# before pinning one here.
# LLM_MODEL=
# LLM_FAST_MODEL=
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.4
# Optional, only if you use these providers instead:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=            (LLM_MODEL must also be set for openai)
# Embeddings use a built-in deterministic hasher unless OpenAI is the provider.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384

# ---- Optimization ----
OPTIMIZER_TIME_LIMIT_SECONDS=10
ROAD_DISTANCE_FACTOR=1.3
DEFAULT_TRAVEL_SPEED_KMH=30

# ---- External services ----
# MAPBOX_ACCESS_TOKEN=

# ---- Observability ----
LOG_LEVEL=INFO
LOG_JSON=false
METRICS_ENABLED=true
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# SENTRY_DSN=

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
