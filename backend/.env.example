# ---- Application ----
ENVIRONMENT=local
DEBUG=true
APP_NAME="AI Itinerary Planner API"
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3111,http://127.0.0.1:3111

# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=itinerary_planner
# Set true only on MongoDB Atlas (or a deployment with Atlas Search).
# When false, semantic search falls back to in-process cosine similarity.
MONGODB_VECTOR_SEARCH_ENABLED=false
MONGODB_VECTOR_INDEX_NAME=place_embedding_index

# ---- Redis (optional) ----
REDIS_ENABLED=false
REDIS_URI=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ---- Celery (optional) ----
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (and validated) in staging and production.
SECRET_KEY=dev-only-insecure-secret-key-change-me-in-every-real-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- AI ----
# stub | gemini | groq   (anthropic and openai are also supported)
# "stub" is deterministic and needs no API key; the full pipeline still runs.
LLM_PROVIDER=stub
# Set ONE of these keys to match LLM_PROVIDER:
#   LLM_PROVIDER=gemini  ->  GOOGLE_GEMINI_KEY   (https://aistudio.google.com/apikey)
#   LLM_PROVIDER=groq    ->  GROQ_API_KEY        (https://console.groq.com/keys)
# GOOGLE_GEMINI_KEY=
# GROQ_API_KEY=
#
# Groq needs its model named here - there is no built-in default, because
# Groq retires models too often for one to stay valid. Pick from
# https://console.groq.com/docs/models. GROQ_FAST_MODEL falls back to GROQ_MODEL.
# Deployed (staging/production), the API refuses to start on Groq without both
# GROQ_API_KEY and GROQ_MODEL rather than quietly serving stub itineraries.
# GROQ_MODEL=
# GROQ_FAST_MODEL=
#
# Gemini defaults to gemini-3.8-flash (fast: gemini-3.5-flash-lite); override
# with LLM_MODEL / LLM_FAST_MODEL. Check provider model pages before pinning.
# LLM_MODEL=
# LLM_FAST_MODEL=
# Timeout per call, and retries (with backoff) on timeouts, 429 and 5xx.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.4
# Optional, only if you use these providers instead:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=            (LLM_MODEL must also be set for openai)
# Embeddings use a built-in deterministic hasher unless OpenAI is the provider.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384

# ---- Optimization ----
# Which algorithm plans the route:
#   ortools             best plans, but ~2s per solve  (default)
#   simulated_annealing within ~0.4% of the best, ~0.1s
#   genetic             within ~1.1%, ~0.1s
#   local_search        within ~1.5%, ~0.1s
#   cheapest_insertion  within ~7%,   near-instant
#   nearest_neighbor    ~72% worse;   near-instant. A baseline, not a choice.
#   auto                runs them all and keeps the best plan
# Measured over 20 random instances of 10-60 places; "worse" is the gap in plan
# cost to the best plan found. Switch away from ortools if solve latency matters
# more to you than the last fraction of a percent of quality.
OPTIMIZER_ALGORITHM=ortools
# Wall-clock budget for the OR-Tools solver. Ignored by the other algorithms,
# which stop on iteration counts so their results do not vary with machine speed.
OPTIMIZER_TIME_LIMIT_SECONDS=10
ROAD_DISTANCE_FACTOR=1.3
DEFAULT_TRAVEL_SPEED_KMH=30

# ---- Road routing ----
# Where travel distances and times come from:
#   haversine         straight-line estimate x ROAD_DISTANCE_FACTOR (default; no network)
#   openrouteservice  measured; free key at openrouteservice.org, or a self-hosted ORS
#   osrm              measured; a self-hosted OSRM (the public demo is not for production)
# Any provider failure falls back to the estimate, and responses say so
# ("estimated": true). Transit is always estimated: neither provider routes it.
ROUTING_PROVIDER=haversine
# ROUTING_API_KEY=
# ROUTING_BASE_URL=
ROUTING_TIMEOUT_SECONDS=4
ROUTING_MAX_RETRIES=2
ROUTING_RETRY_BACKOFF_SECONDS=0.5
# Requests with more points than this use the estimate (ORS free tier: 59).
ROUTING_MAX_LOCATIONS=50
ROUTING_CACHE_TTL_SECONDS=86400
ROUTING_CACHE_MAX_ENTRIES=512
ROUTING_BREAKER_THRESHOLD=3
ROUTING_BREAKER_COOLDOWN_SECONDS=300

# ---- External services ----
# MAPBOX_ACCESS_TOKEN=

# ---- Observability ----
LOG_LEVEL=INFO
LOG_JSON=false
METRICS_ENABLED=true
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# SENTRY_DSN=

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
