# Copy to .env.local for local development.
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time, so they
# must be present when `next build` runs (Vercel: Project Settings > Environment
# Variables; Docker: --build-arg). Never put a secret in a NEXT_PUBLIC_ variable.

# Base URL of the FastAPI backend (no trailing slash, no /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL of this site (used for metadata / share links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Maps ----
# The maps need NO API key. They are drawn with Leaflet over openly-licensed
# tiles: CARTO Voyager ("Clear"), OpenStreetMap ("Streets") and Esri
# ("Satellite"). Leave everything below empty and the maps still work.
#
# Those are free community tile servers with usage policies — fine for
# development, but point at a hosted provider (MapTiler, Stadia, Mapbox...)
# before you put real traffic through them.

# Your own tile provider. When set, it becomes the default layer.
# e.g. https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
NEXT_PUBLIC_MAP_TILE_URL=
# Attribution shown on the map. Required by most providers' terms.
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# Optional extra: a Mapbox public token (pk.*) adds a "Mapbox" style to the
# layer switcher. Not required for the maps to work. Restrict it by URL in the
# Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional: federated sign-in. Client IDs are public, not secrets.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=
